extends baseEmail

//- ============================================================
//- passwordReset.pug
//- Sent to ADMIN when a password reset is requested.
//- CHANGED: Replaced generic blue CTA with site-branded gold
//- button. Added eyebrow label and expiry notice. Preserved
//- all data bindings (resetURL, firstName).
//- ============================================================

block content
  //- ── Eyebrow label ──
  p.eyebrow
    span.eyebrow-line
    | Security Notice

  //- ── Heading ──
  h2.email-heading
    | Password 
    em Reset
    |  Request

  //- ── Greeting + instruction ──
  p Hello, 
    strong #{firstName}
    | .
  p
    | A password reset was requested for your portfolio admin account.
    | Click the button below to securely reset it.
    strong(style='color: #C8A96E;')  This link expires in 10 minutes.

  //- ── Gold CTA button (replaces generic blue btn) ──
  //- CHANGED: Replaced the table-based blue button with the
  //- site-branded gold .btn-cta style defined in baseEmail.
  .btn-wrap
    //- resetURL is bound by the auth controller
    a.btn-cta(href=resetURL, target='_blank') Reset My Password

  hr.divider

  //- ── Safety disclaimer ──
  p(style='font-size: 12px; color: rgba(240,238,232,0.35); text-align: center; margin: 0;')
    | If you did not request this reset, you can safely ignore this email.
    br
    | Your password will not change unless you click the link above.