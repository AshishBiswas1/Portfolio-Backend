extends baseEmail

block content
  h2 Hello #{firstName},
  p Forgot your password? No worries! Click the button below to securely reset it. This private execution link is only valid for 10 minutes.
  
  // Custom button structured natively for standard email table engines
  table.btn(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=resetURL, target='_blank') Reset Your Password
                  
  p If you did not make this request or suspect unexpected activity, please safely disregard this notice.